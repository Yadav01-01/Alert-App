<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.AiScreenActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iv_ai_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/amico_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="64dp"
            android:background="@drawable/circular_main_bg"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_ai_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Assistant"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_below="@id/iv_ai_avatar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tv_ai_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to help you with alerts!"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_below="@id/tv_ai_title"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_ai_action"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Ask AI"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_below="@id/tv_ai_status"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp" />

        <Button
            android:id="@+id/btn_ai_decline"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="@color/cb_errorRed"
            android:textColor="@color/white"
            android:layout_below="@id/btn_ai_action"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>